# ── AI Clinical Report Summarization Assistant ─────────────────────
#
# Copy this file to .env and fill in your API key.
# The pipeline uses OpenRouter (deepseeek-v4-flash) by default.
#
#   cp .env.example .env
#

# Primary: OpenRouter API key (recommended)
OPENROUTER_API_KEY=sk-or-v1-...

# Fallback: OpenAI API key (used if OPENROUTER_API_KEY is not set)
OPENAI_API_KEY=sk-...